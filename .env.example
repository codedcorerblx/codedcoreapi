# ───────────── Required ─────────────
# The single private API key. Every /api/* request must send it as `x-api-key`.
# Generate one:  openssl rand -base64 36
API_SECRET=replace-with-a-long-random-string

# ───────────── Upstream credentials (comma-separated, any count) ─────────────
# Discord bot tokens. At least one is needed for most Discord endpoints.
DISCORD_BOT_TOKENS=token1,token2,token3
# Roblox .ROBLOSECURITY cookie values. Optional: public endpoints work anonymously,
# but cookies add rotation capacity and unlock the presence endpoint.
# Use a dedicated throw-away account, never your main one.
ROBLOX_COOKIES=cookie1,cookie2,cookie3

# ───────────── Persistent storage (analytics + shared cooldowns) ─────────────
# Any Postgres connection string. On Vercel: Storage → Neon → connect to project
# and DATABASE_URL is injected for you.
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# ───────────── Optional tuning (defaults shown) ─────────────
# NEXT_PUBLIC_BASE_URL=https://your-deployment.vercel.app
# UPSTREAM_TIMEOUT_MS=8000
# UPSTREAM_RETRIES=2
# AUTO_PAGINATION_MAX_ITEMS=5000
# AUTO_PAGINATION_MAX_PAGES=50
# AUTO_PAGINATION_TIMEOUT_MS=25000
# BATCH_MAX_SIZE=25
# BATCH_DEFAULT_CONCURRENCY=5
# BATCH_MAX_CONCURRENCY=10
# BATCH_TIMEOUT_MS=50000
# CACHE_MAX_ENTRIES=500
# LOG_RETENTION_DAYS=7
